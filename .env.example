# Sample environment for the kube-traceback MCP server.
#
# The VPS deployment (docker-compose.yml) requires the "required" variables
# below; copy this file to the host env_file (e.g. /opt/kubetraceback/.env),
# replace the example values, and set real secrets there. Never commit the
# real .env file - it is covered by .gitignore.
#
# Variable naming: TRACEBACK_* are application settings, KUBECONFIG* is the
# kubeconfig location, KEYCLOAK_* / MCP_RESOURCE_URL enable Keycloak auth.

# ---------------------------------------------------------------------------
# MCP transport (stdio needs no other transport vars)
# ---------------------------------------------------------------------------
TRACEBACK_MCP_TRANSPORT=http
TRACEBACK_MCP_HOST=0.0.0.0
TRACEBACK_MCP_PORT=8765

# REQUIRED in http mode. Comma-separated allow-lists for the HTTP transport
# (DNS-rebinding protection). Hosts may carry a port; ":*" matches any port
# for that host. Use the real public host(s) of the deployment.
TRACEBACK_MCP_ALLOWED_HOSTS="example.com, example.com:*, 127.0.0.1, 127.0.0.1:*, localhost, localhost:*"
TRACEBACK_MCP_ALLOWED_ORIGINS="https://example.com, http://localhost:6274"

# ---------------------------------------------------------------------------
# Kubernetes access
# ---------------------------------------------------------------------------
# Path to the kubeconfig inside the container. docker-compose.yml bind-mounts
# the cluster kubeconfig (read-only) to this path.
KUBECONFIG=/home/agent/.kube/config

# Default namespace when a tool argument omits it.
TRACEBACK_DEFAULT_NAMESPACE=default
# Lines of log tail returned by the crash-diagnosis tool.
TRACEBACK_LOG_TAIL_LINES=40

# ---------------------------------------------------------------------------
# Keycloak auth (all required together; omit all to run unauthenticated)
# ---------------------------------------------------------------------------
KEYCLOAK_ISSUER_URL="https://keycloak.example.com/realms/lab"
KEYCLOAK_CLIENT_ID=mcp-kubetraceback
KEYCLOAK_REQUIRED_SCOPE=k8s:readonly
# Role prefix: a client role "ns:<namespace>" grants read access to that
# namespace; "ns:*" grants all namespaces.
KEYCLOAK_NS_ROLE_PREFIX=ns:
# Public URL of this MCP server (the token audience / resource URL).
# The Keycloak MCP *client* must be configured so issued tokens carry
# `aud` = KEYCLOAK_CLIENT_ID (or a `resource` claim equal to
# MCP_RESOURCE_URL). Tokens missing that are rejected by the transport's
# bearer check and the tool then reports "no valid access token in context".
MCP_RESOURCE_URL="https://mcp.example.com/mcp"
